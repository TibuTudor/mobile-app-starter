# Docker Compose environment variables
# Copy this file to .env and update the values.

# Your machine's LAN IP address (e.g. 192.168.1.42)
# Find it with: ipconfig getifaddr en0 (macOS) or hostname -I (Linux)
HOST_IP=192.168.1.X

# MySQL credentials
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Laravel APP_KEY (leave blank — generated automatically on first run)
APP_KEY=

# ── Host ports ─────────────────────────────────────────────────────
# Optional. These are the ports exposed on YOUR machine. Uncomment and change
# any that clash with another project running on the same host — the values
# below are the defaults baked into docker-compose.yml, so leaving them
# commented keeps the standard ports. Container-internal ports never change.
#   DB_HOST_PORT    -> MySQL           (default 3307, maps to container 3306)
#   API_HOST_PORT   -> Laravel API     (default 8000, also used in APP_URL / EXPO_PUBLIC_API_URL / Sanctum)
#   PMA_HOST_PORT   -> phpMyAdmin      (default 8090, maps to container 80)
#   METRO_HOST_PORT -> Expo Metro      (default 8081, host==container so the QR code stays reachable)
# DB_HOST_PORT=3307
# API_HOST_PORT=8000
# PMA_HOST_PORT=8090
# METRO_HOST_PORT=8081
